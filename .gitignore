# ==============================================================================
# Multi-Agent Financial Research System - Root .gitignore
# Production-Grade Git Exclusion Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Secrets & Environment Files (Strictly Prohibited from Version Control)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.secret
*credentials*
*.p12
*.git_bak
.git_bak/

# ------------------------------------------------------------------------------
# 2. Python Build, Cache & Bytecode Artifacts
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------------------------------------------
# 3. Virtual Environments
# ------------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.ENV/

# ------------------------------------------------------------------------------
# 4. Local Relational Databases & Storage
# ------------------------------------------------------------------------------
*.db
*.db-journal
*.sqlite
*.sqlite3
documents.db
test_*.db
Engine/documents.db
Engine/test_*.db

# ------------------------------------------------------------------------------
# 5. Local Vector Database Stores & Embeddings Cache
# ------------------------------------------------------------------------------
chroma_db/
Engine/chroma_db/
qdrant_storage/
Engine/qdrant_storage/
.cache/
Engine/.cache/
huggingface/
torch/

# ------------------------------------------------------------------------------
# 6. Uploaded Financial Documents (Dynamic Runtime Storage)
# Preserve directory structure with .gitkeep; exclude raw uploaded PDF filings.
# ------------------------------------------------------------------------------
uploads/*
Engine/uploads/*
!uploads/.gitkeep
!Engine/uploads/.gitkeep

# Preserve official institutional seed documents
!Engine/seed_documents/
!seed_documents/
!Engine/seed_documents/*.pdf
!seed_documents/*.pdf

# ------------------------------------------------------------------------------
# 7. Testing, Coverage & Static Analysis Artifacts
# ------------------------------------------------------------------------------
.pytest_cache/
Engine/.pytest_cache/
.coverage
Engine/.coverage
htmlcov/
Engine/htmlcov/
.ruff_cache/
Engine/.ruff_cache/
.mypy_cache/
Engine/.mypy_cache/
coverage.xml
nosetests.xml
*.cover
*.log

# ------------------------------------------------------------------------------
# 8. Node.js & Frontend Build Artifacts
# ------------------------------------------------------------------------------
node_modules/
Frontend/node_modules/
Frontend/dist/
Frontend/.vite/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.turbo/
.parcel-cache/

# ------------------------------------------------------------------------------
# 9. IDE, Editor & OS Metadata
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

